WEB_PORT=5000

# JWT
JWT_SECRET_KEY=generate-another-random-string-here

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (get your key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
